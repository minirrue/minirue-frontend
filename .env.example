# minirue-frontend (storefront) — environment
#
# Copy to .env for local work. .env is gitignored; deployment values live in
# Vercel, not here.

# Canonical storefront origin, no trailing slash. Every canonical URL, JSON-LD
# @id/url and the sitemap are built from this. Defaults to https://minirueshop.com
# in lib/seo/config.ts when unset.
NEXT_PUBLIC_SITE_URL=https://minirueshop.com

# Backend API origin used by server rendering and the /v1 rewrite, without a
# trailing slash. Set this in Vercel per environment: production's backend in
# Production and preview's backend in Preview. Without it, Vercel server
# rendering calls its own /v1 rewrite; local development uses localhost:8002.
# Browser requests always use this site's /v1 path.
API_PROXY_ORIGIN=http://localhost:8002

# Cookie domain shared by the storefront and the API.
#
# REQUIRED IN PRODUCTION. The storefront and the API are separate origins, so
# the analytics visitor cookie (mr-vid) must carry an explicit Domain covering
# both, or it never reaches the API and every visitor silently falls back to a
# server-side fingerprint — unique-visitor counts get less stable and
# returning-visitor and MAU figures degrade. Nothing errors.
#
# Set it to the registrable domain with a leading dot (.minirueshop.com) and
# make sure the backend's own COOKIE_DOMAIN matches. Leave unset locally: the
# cookie falls back to host-only, which is correct for localhost.
#
# Verify after deploy on GET /v1/analytics/quality — the visitor-source split
# should be overwhelmingly COOKIE, not FINGERPRINT.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Set to "true" to switch off first-party analytics collection entirely. The
# tracker becomes a no-op; nothing is queued and nothing is sent.
NEXT_PUBLIC_ANALYTICS_DISABLED=

# Meta (Facebook) Pixel ID from Events Manager -> Data sources. Loads the pixel
# on every page (components/seo/MetaPixel.tsx). Unset = the shop's own pixel
# (1734924024399668). Build-time value: redeploy after changing it.
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Events Manager pixel ID (build-time; redeploy after changing it).
NEXT_PUBLIC_TIKTOK_PIXEL_ID=DALS583C77U9262DR9Q0

# Image delivery
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Google Search Console HTML-tag verification (Search Console -> Add property ->
# HTML tag -> copy the content value). Read in app/layout.tsx's generateMetadata.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification (msvalidate.01 meta tag content value).
# Read in app/layout.tsx's generateMetadata.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_TRUSTPILOT_INTEGRATION_KEY=ZO0eVJFmYpzTQAAH
