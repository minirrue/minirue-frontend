# minirue-frontend (storefront) — environment
#
# Copy to .env for local work. .env is gitignored; production values live in
# the Dokploy dashboard, not here.

# Backend API origin, without a trailing slash. The app appends /v1 itself.
# Defaults to http://localhost:8002 when unset.
NEXT_PUBLIC_API_URL=http://localhost:8002

# Cookie domain shared by the storefront and the API.
#
# REQUIRED IN PRODUCTION. The storefront and the API are separate origins, so
# the analytics visitor cookie (mr-vid) must carry an explicit Domain covering
# both or it never reaches the API — in which case every visitor silently
# falls back to a server-side fingerprint, unique-visitor counts get less
# stable, and returning-visitor and MAU figures degrade.
#
# Set it to the registrable domain with a leading dot, e.g. .minirue.com, and
# make sure the backend's own COOKIE_DOMAIN matches. Leave unset locally —
# the cookie then falls back to host-only, which is correct for localhost.
#
# To confirm it is working in production, check the visitor-source split on
# the analytics quality endpoint: it should be overwhelmingly COOKIE, not
# FINGERPRINT.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Set to "true" to switch off first-party analytics collection entirely.
# The tracker becomes a no-op; nothing is queued and nothing is sent.
NEXT_PUBLIC_ANALYTICS_DISABLED=

# Image delivery
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Search-console verification tokens, rendered into <head> by app/layout.tsx
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
